class LinearSearch:
  def __init__(self,arr):
    self.arr = arr

  def Search(self,target):
    for i in range(len(self.arr)):
      if self.arr[i] == target:
        return i

    return -1


array = [5,8,9,30]
search = LinearSearch(array)
found = search.Search(int(input("Enter the element to find: ")))
if found ==-1:
  print("The element is not present in the array")
else:
  print("The element needed is present at the index: ",found)
